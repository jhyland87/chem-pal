{
  "editor.tabSize": 2,
  "editor.defaultFormatter": "vscode.typescript-language-features",
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.defaultFoldingRangeProvider": "vscode.typescript-language-features",
  "js/ts.preferences.quoteStyle": "single",
  "jestTestExplorer.logpanel": true,
  "jest.runMode": "on-demand",
  "notebook.defaultFormatter": null,
  "js/ts.format.insertSpaceAfterTypeAssertion": false,
  "editor.autoIndent": "full",
  "eslint.workingDirectories": [
    {
      "pattern": "src",
      "exclude": [
        "node_modules",
        "dist",
        "build",
        "coverage",
        "dist",
        "dev"
      ]
    }
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.sortImports": "always",
  },
  "prettier.experimentalTernaries": true,
  "prettier.printWidth": 100,
  "js/ts.preferences.organizeImports": {
    "accentCollation": true,
    "typeOrder": "auto",
    "enabled": true,
    //"style": "alphabetical",
    "sortOrder": [
      "lowercaseLetters",
      "uppercaseLetters"
    ],
    "grouping": [
      "moduleSpecifier",
      "typeAndValue"
    ],
    "caseFirst": "default"
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "js/ts.suggest.jsdoc.enabled": false
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "js/ts.suggest.jsdoc.enabled": false
  },
  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.ignoreUntitled": true,
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.suggest.autoImports": false,
  "js/ts.preferences.autoImportSuggestions": true,
  "js/ts.preferences.autoImportSuggestionsMode": "literals",
  "[typescript][typescriptreact]": {
    "js/ts.inlayHints.propertyDeclarationTypes.enabled": false,
    "js/ts.inlayHints.parameterNames.enabled": "literals",
    "js/ts.inlayHints.variableTypes.enabled": false,
    "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
    "js/ts.inlayHints.enumMemberValues.enabled": true
  },
  "typescript.preferences.namingConvention": {
    "enabled": true,
    "options": {
      "camelCase": true,
      "pascalCase": true,
      "snake_case": true,
      "kebab-case": true
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "openCoverage.coverageFilePath": "coverage/index.html",
  "vitest.shellType": "terminal",
  "testing.coverageToolbarEnabled": true,
  "npm.packageManager": "pnpm",
  "files.exclude": {
    ".claude": false,
    "**/.claude/**": false,
    "**/.claude/worktrees": true,
    "**/.claude/settings.local.json": true
  },
  "search.exclude": {
    ".claude/**": false,
    "**/.claude/**": false,
    "**/.claude/worktrees": true
  },
}