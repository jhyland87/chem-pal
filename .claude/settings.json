{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "permissions": {
    "allow": [
      "Bash(pnpm type-check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test:run)",
      "Bash(pnpm test:run *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm run generate)",
      "Bash(pnpm run docs:check)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./docs/**)",
      "Read(./coverage/**)",
      "Read(./dev/**)",
      "Edit(./docs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-ts.mjs\""
          }
        ]
      }
    ]
  }
}
